# Stage 1: Compile and Package (Steps b & c)
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build

# Copy project definition and source code
COPY pom.xml .
COPY src ./src

# Compile and package the artifact, ignoring tests for pipeline speed
RUN mvn clean package -DskipTests

# Stage 2: Create Final Minimal Docker Image (Step e)
FROM eclipse-temurin:17-jre
WORKDIR /app

# Step e.ii: Ensure the Docker image doesn't run as root
RUN groupadd -r appgroup && useradd -r -g appgroup appuser
USER appuser

# Copy only the compiled artifact from the builder stage
COPY --from=builder --chown=appuser:appgroup /build/target/*.jar app.jar

# Define execution command
ENTRYPOINT ["java", "-jar", "app.jar"]
